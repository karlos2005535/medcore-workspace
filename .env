# ============================================================
# medcore-workspace/.env
# Modul 03 — RabbitMQ EDA + Redis Idempotency Cache
# ============================================================

# ---- Patient DB (PostgreSQL 16) ----
HOST_PORT_PATIENT_DB=5442
PATIENT_DB_USER=usr_patient_svc
PATIENT_DB_PASS=SecuredPassPatient2026!
PATIENT_DB_NAME=medcore_patient_db

# ---- Appointment DB (PostgreSQL 16) ----
HOST_PORT_APPOINTMENT_DB=5433
APPOINTMENT_DB_USER=usr_appointment_svc
APPOINTMENT_DB_PASS=SecuredPassAppt2026!
APPOINTMENT_DB_NAME=medcore_appointment_db

# ---- Billing DB (PostgreSQL 16) ----
HOST_PORT_BILLING_DB=3307
BILLING_DB_USER=usr_billing_svc
BILLING_DB_PASS=SecuredPassBilling2026!
BILLING_DB_NAME=medcore_billing_db

# ---- Pharmacy MongoDB 7.0 ----
HOST_PORT_PHARMACY_DB=27018
MONGO_ROOT_USER=adm_pharmacy_svc
MONGO_ROOT_PASS=SecuredPassPharm2026!
PHARMACY_DB_NAME=medcore_pharmacy_db

# ---- RabbitMQ (Modul 03) ----
RABBITMQ_DEFAULT_USER=admin_medcore
RABBITMQ_DEFAULT_PASS=SecuredPassRabbit2026!
RABBITMQ_DEFAULT_VHOST=/medcore_vhost
RABBITMQ_HOST_PORT_AMQP=5672
RABBITMQ_HOST_PORT_MGMT=15672

# ---- Redis Idempotency (Modul 03) ----
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
# Alamat Redis untuk aplikasi yang dijalankan di HOST (go run / node langsung)
REDIS_ADDR=localhost:6379
# Alamat Redis untuk aplikasi yang dijalankan di dalam Docker network
REDIS_ADDR_DOCKER=medcore-redis:6379